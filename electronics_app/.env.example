# Frontend environment — copy to `.env.local` for local dev.
#
# Vite only exposes variables prefixed with VITE_, and it INLINES them at
# BUILD time — so changing this file (or Render's env var) requires a rebuild,
# not just a restart.
#
# If you set nothing, src/lib/api.js already does the right thing:
#   npm run dev   → http://localhost:5001
#   npm run build → https://electronics-hub.onrender.com
# Use this file only to point at a different backend.

# Absolute origin of the Express API, no trailing slash.
#   local backend  → http://localhost:5001
#   Render         → https://electronics-hub.onrender.com
#   mock API       → http://localhost:5001  (node mock/server.mjs)
VITE_API_URL=http://localhost:5001
