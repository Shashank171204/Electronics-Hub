# Backend environment — copy to `.env` for local dev.
# On Render: Electronics Hub backend service → "Environment" tab → add these.
# (.env itself is git-ignored on purpose.)

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/electronicsHub

# Render sets PORT automatically (it routes 10000 → your app). Leave as-is
# locally; the app falls back to 5001 when it is unset.
PORT=5001

# --- CORS -------------------------------------------------------------------
# Browser origins allowed to call this API. Comma-separated, no trailing slash.
# Anything after the first entry is only needed if you deploy more than one
# frontend (staging, a PR preview, …).
CORS_ORIGINS=https://electronics-hub-frontend.onrender.com

# Optional aliases if you prefer those names — CORS_ORIGINS wins if both are set:
#   CORS_ORIGIN=https://electronics-hub-frontend.onrender.com
#   FRONTEND_URL=https://electronics-hub-frontend.onrender.com
#
# Use "*" to allow every origin (public read API). Note that this disables
# credentialed requests (cookies / Authorization with CORS credentials), which
# browsers refuse to combine with a wildcard.
# CORS_ORIGINS=*

# Set in Render so localhost dev origins are dropped from the allowlist.
# NODE_ENV=production
